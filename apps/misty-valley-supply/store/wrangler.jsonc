{
  // Cloudflare Workers static-assets deploy for the Misty Valley Supply store.
  // Deploy: npx wrangler deploy   (after `npx wrangler login` once)
  // Result: https://misty-valley-supply.<account>.workers.dev — free plan OK.
  // Custom domain: add mistyvalleysupply.com in the Cloudflare dash after purchase.
  "name": "misty-valley-supply",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
